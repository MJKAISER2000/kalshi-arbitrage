# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# --- Credentials -------------------------------------------------------------
# API key ID from the Kalshi dashboard.
KALSHI_API_KEY_ID=

# Path to the RSA private key file. Store it OUTSIDE the repo.
KALSHI_PRIVATE_KEY_PATH=

# --- Environment -------------------------------------------------------------
# demo | production. Credentials are NOT shared between the two.
KALSHI_ENVIRONMENT=demo

# --- Trading mode ------------------------------------------------------------
# research | backtest | paper | live
# Live trading requires BOTH of the below plus a passing live-gate check.
# The gate fails closed: anything missing or malformed means no live trading.
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false

# --- Rate limiting -----------------------------------------------------------
# basic | advanced | expert | premier | paragon | prime | prestige
KALSHI_API_TIER=basic

# --- Storage -----------------------------------------------------------------
DATABASE_URL=sqlite:///data/database/kalshi.db

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
